# ============================================
# SCENTSHIELD AI — Environment Configuration
# ============================================
# Copy this to .env and fill in your values

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Claude AI) ---
ANTHROPIC_API_KEY=sk-ant-your-key

# --- Stripe (Billing) ---
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_INDIE=price_indie_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# --- Resend (Email) ---
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=notifications@scentshield.ai

# --- Upstash Redis (Cache & Queues) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# --- Upstash QStash (Scheduled Jobs) ---
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# --- LinkedIn API (Content Agent) ---
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret
LINKEDIN_ACCESS_TOKEN=your-access-token

# --- App Config ---
APP_URL=https://app.scentshield.ai
API_URL=https://api.scentshield.ai
NODE_ENV=development
LOG_LEVEL=info

# --- Agent Config ---
AGENT_MONITORING_CRON=0 2 * * *
AGENT_CONTENT_CRON=0 9 * * 1,3,5
AGENT_SALES_CRON=0 10 * * 1
AGENT_ESCALATION_EMAIL=alfred@scentshield.ai
